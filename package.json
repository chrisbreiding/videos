{
  "name": "videos",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "vite",
    "build": "rm -rf dist && vite build",
    "preview": "vite preview --port 8088",
    "deploy": "echo 'Deploying via netlify' && git push origin $(git rev-parse --abbrev-ref HEAD):production",
    "deploy:functions": "firebase deploy --only functions",
    "lint": "eslint 'src/**/*.+(js|jsx)' --fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:coverage": "rm -rf .nyc_output coverage && COVERAGE=1 playwright test; nyc report --temp-dir=.nyc_output --report-dir=coverage --reporter=text-summary --reporter=html",
    "coverage:report": "nyc report --temp-dir=.nyc_output --report-dir=coverage --reporter=text --reporter=html"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-eslint": "^10.1.0",
    "eslint": "^9",
    "eslint-plugin-crb": "^2.0.7",
    "eslint-plugin-react": "^7.37.5",
    "firebase-tools": "^15.24.0",
    "nyc": "^18.0.0",
    "stylus": "^0.64.0",
    "vite": "^8.1.4",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "dependencies": {
    "array-move": "^4.0.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "firebase": "^12.16.0",
    "font-awesome": "4.7.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.0",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "qs": "^6.15.3",
    "react": "^17",
    "react-document-title": "^2.0.3",
    "react-dom": "^17",
    "react-router": "^6",
    "react-router-dom": "^6",
    "react-sortable-hoc": "^2.0.0"
  }
}
