{
  "name": "videos",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "postinstall": "node scripts/generate-font-awesome-types.js",
    "start": "vite",
    "build": "rm -rf dist && vite build",
    "preview": "vite preview --port 8088",
    "deploy": "echo 'Deploying via netlify' && git push origin $(git rev-parse --abbrev-ref HEAD):production",
    "deploy:functions": "firebase deploy --only functions",
    "lint": "eslint 'src/**/*.+(ts|tsx)' 'tests/**/*.ts' playwright.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:coverage": "rm -rf .nyc_output coverage && COVERAGE=1 playwright test; nyc report --temp-dir=.nyc_output --report-dir=coverage --reporter=text-summary --reporter=html",
    "coverage:report": "nyc report --temp-dir=.nyc_output --report-dir=coverage --reporter=text --reporter=html"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-decorators": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@playwright/test": "^1.61.1",
    "@types/lodash": "^4.17.24",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-plugin-crb": "^2.0.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.24.0",
    "nyc": "^18.0.0",
    "prettier": "3.9.5",
    "stylus": "^0.64.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "firebase": "^12.16.0",
    "font-awesome": "4.7.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.0",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "qs": "^6.15.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0"
  }
}
